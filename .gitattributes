# Enforce LF line endings for source files (matches .editorconfig)
*.lua text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Binary files - never diff or merge
*.mpackage binary
*.db binary

# Git hooks run under sh on every system: a CR breaks them
.githooks/* text eol=lf
