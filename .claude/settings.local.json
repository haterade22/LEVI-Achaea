{
  "permissions": {
    "allow": [
      "Bash(powershell -Command \"Expand-Archive -Path ''.\\\\Loki 2.1.4 + AK 8.6.5 \\(modified\\) \\(package install\\).mpackage'' -DestinationPath ''.\\\\extracted'' -Force\")",
      "Bash(powershell -Command \"Copy-Item ''.\\\\Loki 2.1.4 + AK 8.6.5 \\(modified\\) \\(package install\\).mpackage'' ''.\\\\temp.zip''; Expand-Archive -Path ''.\\\\temp.zip'' -DestinationPath ''.\\\\extracted'' -Force; Remove-Item ''.\\\\temp.zip''\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 10000,
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact.sh",
            "timeout": 10000,
            "statusMessage": "Saving working context before compaction..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE 'convert_to_muddler|muddle\\.bat|build\\.sh'; then if pgrep -f 'convert_to_muddler|muddle' > /dev/null 2>&1; then echo 'BLOCKED: A build process is already running.'; exit 2; fi; fi; exit 0",
            "statusMessage": "Checking for concurrent builds..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-git-bypass.sh",
            "timeout": 5000,
            "statusMessage": "Checking git safety..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-before-commit.sh",
            "timeout": 30000,
            "statusMessage": "Validating Lua syntax..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-config.sh",
            "timeout": 5000,
            "statusMessage": "Checking config protection..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-config.sh",
            "timeout": 5000,
            "statusMessage": "Checking config protection..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-changelog.sh",
            "timeout": 5000,
            "statusMessage": "Checking CHANGELOG..."
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-permission-denied.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/set-session-title.sh",
            "timeout": 5000,
            "statusMessage": "Setting session title..."
          }
        ]
      }
    ]
  },
  "showThinkingSummaries": true,
  "env": {
    "API_TIMEOUT_MS": "600000"
  },
  "statusLine": {
    "type": "command",
    "command": "branch=$(git branch --show-current 2>/dev/null); version=$(cat version.txt 2>/dev/null | tr -d '[:space:]'); dirty=$(git diff --shortstat 2>/dev/null | sed 's/ file.*/f/' | sed 's/^ //'); echo \"v${version:-?} ${branch:-detached}${dirty:+ ($dirty)}\"",
    "refreshInterval": 30
  }
}
